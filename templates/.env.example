# Flask secret key
FLASK_SECRET_KEY=your-secret-key

# Google service account (base64 encoded JSON)
SERVICE_ACCOUNT_JSON_PATH=service_account.json
SERVICE_ACCOUNT_JSON_B64=<base64-encoded-service-account-json>

# Google Sheets keys
TIMETABLE_SHEET_KEY=your_timetable_sheet_id
QUESTIONS_SHEET_KEY=your_questions_sheet_id
GROUP_RULES_SHEET_KEY=your_group_rules_sheet_id

# Google Drive folder IDs
FORMS_FOLDER_ID=your_forms_folder_id
DRIVE_PARENT_FOLDER_ID=your_drive_parent_folder_id

# Optional cache TTLs
DRIVE_CACHE_TTL=180
SHEETS_CACHE_TTL=180

# Flask port
PORT=5000